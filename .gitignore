# Gitignore for the PyMaxQ *template repository* itself.
# (The generated-project gitignore lives at template/.gitignore.)

# uv / virtualenvs
.venv/
.uv-cache/

# Python bytecode / build
__pycache__/
*.py[cod]
build/
dist/
*.egg-info/

# Test / lint / type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.coverage
.coverage.*
htmlcov/

# Docs build output
public/
site/
.dogfood-site/   # scratch project the docs workflow generates from this template

# Local tooling / editor
.claude/settings.local.json
.DS_Store
*.swp
.serena/
