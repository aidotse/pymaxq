[build-system]
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
dynamic = ["version"] # Tells Hatchling to calculate this dynamically
description = "{{ description }}"
authors = [{name = "{{ author }}", email = "{{ email }}"}]
license = {text = "MIT"}
readme = "README.md"
requires-python = ">=3.10"

# Main (runtime) dependencies
dependencies = [
    "hydra-core>=1.3.2",
    "omegaconf>=2.3.0", # imported directly by scripts/example.py (also a hydra-core dep)
    "loguru>=0.7.3",
]

[project.optional-dependencies]
# Optional AI/agent tooling for *developing* this project (e.g. with Claude Code).
# Not required by the package at runtime. Install with: `uv sync --extra agent`.
agent = [
    "headroom-ai[code,html,mcp,otel,proxy,relevance,reports,spreadsheet]>=0.27.0",
]

[project.urls]
Homepage = "{{ repo_url }}"
Documentation = "{{ docs_url }}"

[dependency-groups]
dev = [
    "pytest>=8.3.3",
    "pytest-xdist>=3.8.0",
    "pytest-cov>=5.0.0",
    "pytest-html>=4.1.1",
    "mypy>=1.12.1",
    "ruff>=0.7.0",
    "pre-commit>=4.0.1",
    "poethepoet>=0.29.0",
    "coverage>=7.6.4",
    "nox>=2024.4.15",
    "deptry>=0.20.0",
    "commitizen>=3.29.0",
    "mkdocs-material>=9.5.42",
    "mkdocstrings[python]>=0.26.0",
    "mike>=2.1.3",
    "genbadge[coverage,tests]>=1.1.1",
]

#[[tool.uv.index]]
#name = "{{ project_name }}"
#url = "https://gitlab.mgmt.ai.se/api/v4/projects/<id>/packages/pypi/simple"


### Tools config

[tool.hatch.version]
source = "vcs" # Use git tags for versioning
fallback-version = "0.0.0"

[tool.hatch.build.targets.wheel]
packages = ["{{ package_name }}"]

[tool.pytest.ini_options]
addopts = [
  "-ra",
  "--cov",
  "--full-trace",
  "--cov-config=pyproject.toml",
  "--capture=tee-sys",
  "--html=docs/exported/pytest.html",
  "--junit-xml=docs/exported/pytest.xml",
  "--self-contained-html",
  "--showlocals",
]

testpaths = ["test"]
log_cli = true
log_cli_level = 10

[tool.coverage.report]
fail_under = 60
show_missing = true
skip_empty = true

[tool.coverage.run]
branch = true
source = ["{{ package_name }}"]

[tool.coverage.html]
directory = "docs/exported/coverage"

[tool.coverage.xml]
output = "docs/exported/coverage.xml"

[tool.mypy]
explicit_package_bases = true
ignore_missing_imports = true
pretty = true
show_error_context = true
show_traceback = true

[tool.ruff]
fix = true
line-length = 120
target-version = "py310"

[tool.ruff.lint]
ignore = [
  "PLR",    # pylint recommendations
  "D104",   # Missing docstring in public package
  "ANN002", # Missing type annotation:  *args
  "ANN003", # Missing type annotation: **kwargs
]
select = [
  "E",    # pycodestyle errors
  "F",    # pyflakes
  "I",    # isort (replaces standalone isort)
  "UP",   # pyupgrade (replaces standalone pyupgrade)
  "C",    # flake8-comprehensions
  "B",    # flake8-bugbear
  "S",    # flake8-bandit
  "A",    # flake8-builtins
  "INP",  # flake8-no-pep420
  "PIE",  # flake8-pie
  "PL",   # pylint
]

[tool.ruff.lint.per-file-ignores]
"test/*" = ["S101"]

[tool.ruff.lint.pydocstyle]
convention = "google"

# Conventional-commits driven versioning. Commitizen reads the current version from
# the latest git tag (version_provider = scm, pairs with hatch-vcs) and, on `cz bump`,
# computes the next version from commit messages, writes the new tag, and updates the
# CHANGELOG. `major_version_zero` keeps breaking changes at a minor bump while < 1.0.
[tool.commitizen]
name = "cz_conventional_commits"
version_provider = "scm"
tag_format = "v$version"
major_version_zero = true
update_changelog_on_bump = true
changelog_incremental = true
# `[skip ci]` stops the bump's own changelog commit from re-triggering the pipeline
# (and re-bumping). Publishing runs as a continuation of the bump job, not on the tag.
bump_message = "bump: version $current_version → $new_version [skip ci]"

# Dependency hygiene: flags unused / missing / transitive / misplaced dependencies.
[tool.deptry]
known_first_party = ["{{ package_name }}"]
# noxfile.py is dev-only orchestration, not shipped code — don't scan it.
extend_exclude = ["noxfile.py"]

[tool.deptry.per_rule_ignores]
# headroom-ai is optional agent/dev tooling, intentionally not imported by the package.
DEP002 = ["headroom-ai"]
# pytest is imported by the test suite (the test/ dir) but is correctly a dev dependency.
DEP004 = ["pytest"]

[tool.poe]
shell_interpreter = "bash"
verbosity = 1

# --- Quality gate ---------------------------------------------------------------------

# Run all pre-commit hooks (ruff lint+format, mypy, file hygiene) over the whole repo.
[tool.poe.tasks.lint]
cmd = "pre-commit run --all-files"
help = "Run all linting / formatting / type-check hooks."

# Dependency hygiene check (unused / missing / transitive / misplaced deps).
[tool.poe.tasks.deps-check]
cmd = "deptry ."
help = "Check dependency hygiene with deptry."

# Audit dependencies for known vulnerabilities using uv's native, lockfile-aware auditor.
# NOTE: `uv audit` is currently a uv preview feature; the flag opts in explicitly and
# silences the experimental warning. If you need a fully stable auditor, swap in pip-audit.
[tool.poe.tasks.audit]
cmd = "uv audit --preview-features audit-command"
help = "Audit dependencies for known security advisories."

# Clean temporary files from the repo
[tool.poe.tasks.clean]
shell = """
  rm -rf \
    .coverage \
    .mypy_cache \
    .pytest_cache \
    .ruff_cache \
    .nox \
    .site \
    public \
    **/__pycache__ \
    docs/exported \
    */configs/__pycache__ \
"""

# --- Testing --------------------------------------------------------------------------

# Run unit testing using pytest on a single interpreter. Generate a coverage report in
# different output formats (this is the canonical run that feeds docs/badges).
[tool.poe.tasks.test]
sequence = [
  { cmd = "pytest -n ${cpus} ${test}" },
  { cmd = "coverage xml" },
  { cmd = "coverage html" },
  { cmd = "coverage report" },
]
help = "Run unit testing and generate coverage report"
args = [
  { name = "cpus", multiple = false, positional = true, default = 1, help = "Number of cpus to use for xdist" },
  { name = "test", multiple = true, positional = true, default = "test/unit", help = "Unit tests to run" }
]

# Run the test suite across all supported Python versions (matrix correctness, no coverage).
[tool.poe.tasks.test-all]
cmd = "nox -s tests"
help = "Run tests across all supported Python versions via nox."

# Export test artifacts
[tool.poe.tasks.export-test-artifacts]
sequence = [
  { cmd = "genbadge tests -i ${directory}/pytest.xml -o ${directory}/tests.svg" },
  { cmd = "genbadge coverage -i ${directory}/coverage.xml -o ${directory}/coverage.svg" },
]
help = "Generate test/coverage badges from exported artifacts"
args = [
  { name = "directory", default = "docs/exported", help = "Where to look for required input files, and where to put output artifacts" }
]

# --- Build & versioning ---------------------------------------------------------------

# Build the distributable package (wheel + sdist) into dist/.
[tool.poe.tasks.build]
cmd = "uv build"
help = "Build the wheel + sdist into dist/."

# Bump the version from conventional commits: computes the next version, updates the
# CHANGELOG, commits it, and creates the git tag. Push commit + tag afterwards.
[tool.poe.tasks.bump]
cmd = "cz bump --yes"
help = "Bump version from conventional commits (updates CHANGELOG + creates tag)."

# Render the changelog without bumping (useful for previews / release notes).
[tool.poe.tasks.changelog]
cmd = "cz changelog"
help = "Render CHANGELOG.md from conventional commits."

# Use 'git ls-remote' to get the authoritative list of tags directly from the remote.
# This is non-destructive and ignores any potentially stale or incorrect local tags.
[tool.poe.tasks.get-latest-tag]
# `grep .` makes the `|| echo` fallback fire on empty input (no remote / no tags yet),
# otherwise the `||` would bind to `tail`, which succeeds on empty input and returns "".
shell = "git ls-remote --tags --refs origin 2>/dev/null | awk '{print $2}' | sed 's:^refs/tags/::' | sort -V | tail -n 1 | grep . || echo '0.0.0'"
help = "Fetch the highest version tag from the remote registry."
executor = "simple"

# --- Documentation --------------------------------------------------------------------

# Build the documentation. If using Gitlab, pushing these docs is built directly into the CI pipeline.
# Note, this requires the `test` task output.
[tool.poe.tasks.docs]
shell = """
  cp README.md docs/index.md
  cp LICENSE.md docs/
  cp CONTRIBUTING.md docs/
  mkdocs build ${verbose:+ -v}
"""
help = "Build docs (make sure to first run the `test` task)."
args = [
  { name = "verbose", type = "boolean", help = "True for verbose output" },
]

# Tags a new version of the documentation.
# Explanation: think of mike as making structural changes to the `public` directory to support
# versioning. If called with no `--push` flag, it simply commits these changes to the specified branch, so you can check those out manually.
[tool.poe.tasks.docs-version]
shell = """
  # Use the CI variable if it exists, otherwise query Git
  CURRENT=${CI_COMMIT_TAG:-$(poe get-latest-tag)}
  echo "Found most current tag: $CURRENT"

  # 2. Extract Major.Minor (e.g., v1.2.3 -> 1.2)
  # ${CURRENT#v} removes the 'v'
  # cut -d. -f1,2 grabs the first two segments
  VERSION=$(echo ${CURRENT#v} | cut -d. -f1,2)

  echo "Deploying docs for version: $VERSION"

  # 3. Run mike
  mike deploy ${prefix:+ --deploy-prefix ${prefix}} ${remote:+ -r ${remote}} ${branch:+ -b ${branch}} ${push:+ --push} -F mkdocs.yaml -u $VERSION latest
  mike set-default ${prefix:+ --deploy-prefix ${prefix}} ${remote:+ -r ${remote}} ${branch:+ -b ${branch}} latest
"""
help = """Updates the docs version. Make sure to build the docs first with `docs` task."""
args = [
  { name = "prefix", help = "Optional, directory name where to put deployed docs" },
  { name = "remote", help = "Optional, the remote where to push" },
  { name = "branch", help = "Optional, the branch where to push" },
  { name = "push", type = "boolean", help = "Whether to push changes directly with mike." },
]
